/// A project is led by one project manager.
entityRelationship 'Project Managed By'
	lineageTag: aa3a9fa8-c58b-54e9-b4f6-da0bdb97a0ad
	fromEntity: Project
	toEntity: ProjectManager

	backingConfiguration
		relationship: rel_project_managed_by

/// A document belongs to one project.
entityRelationship 'Document Of Project'
	lineageTag: 93d9262c-dda9-5224-b3e7-3175715432d4
	fromEntity: ProjectDocument
	toEntity: Project

	backingConfiguration
		relationship: rel_document_of_project

/// An email refers to one project.
entityRelationship 'Email About Project'
	lineageTag: 4fd8f93f-8d28-59b6-9b9b-9474db4916bb
	fromEntity: Email
	toEntity: Project

	backingConfiguration
		relationship: rel_email_about_project

/// A task belongs to one project.
entityRelationship 'Task Of Project'
	lineageTag: 64d1fff7-27e3-5513-8c8f-5ca445557039
	fromEntity: Task
	toEntity: Project

	backingConfiguration
		relationship: rel_task_of_project

/// A task depends on its predecessor tasks. It cannot start before all of them have finished. Follow the relationship repeatedly to find every task that is affected, directly or indirectly, when a task is delayed.
entityRelationship 'Task Depends On'
	lineageTag: c40bc038-08e6-51c7-9f5a-2e37dead0959
	fromEntity: Task
	toEntity: Task

	backingConfiguration
		type: table
		table: task_dependencies
		fromRelationship: rel_dependency_task
		toRelationship: rel_dependency_predecessor

/// A material delivery is supplied by one recorded company.
entityRelationship 'Delivery From Supplier'
	lineageTag: 456a732c-fef0-48b0-8be8-2f4d0b4d5501
	fromEntity: MaterialDelivery
	toEntity: Supplier

	backingConfiguration
		relationship: rel_delivery_from_supplier

/// A material delivery contains one specific product.
entityRelationship 'Delivery Of Material'
	lineageTag: 456a732c-fef0-48b0-8be8-2f4d0b4d5502
	fromEntity: MaterialDelivery
	toEntity: Material

	backingConfiguration
		relationship: rel_delivery_of_material

/// A material delivery is allocated to one work package, which identifies its project.
entityRelationship 'Delivery For Task'
	lineageTag: 456a732c-fef0-48b0-8be8-2f4d0b4d5503
	fromEntity: MaterialDelivery
	toEntity: Task

	backingConfiguration
		relationship: rel_delivery_for_task

/// A supplier lists a material in its assortment, even without any project delivery. Use this relationship in reverse from a disrupted delivery's material to identify other suppliers immediately as part of the disruption assessment, even without an explicit request for alternatives. This is a potential sourcing relationship, not proof of stock, delivery capacity, a quotation or an order.
entityRelationship 'Supplier Offers Material'
	lineageTag: 456a732c-fef0-48b0-8be8-2f4d0b4d5603
	fromEntity: Supplier
	toEntity: Material

	backingConfiguration
		type: table
		table: supplier_materials
		fromRelationship: rel_portfolio_supplier
		toRelationship: rel_portfolio_material
