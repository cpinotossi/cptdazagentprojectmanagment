table task_dependencies
	lineageTag: 3f72f8bd-d860-5f9a-83a1-108a179a44ab

	column TaskId
		dataType: string
		lineageTag: e8c133d9-71b2-58b1-97cd-0130df09d6bb
		sourceColumn: TaskId

	column PredecessorId
		dataType: string
		lineageTag: 1a2b662c-86c1-56d9-aaf4-0074003c383a
		sourceColumn: PredecessorId

	partition task_dependencies-partition = entity
		mode: directQuery
		source
			entityName: task_dependencies
			expressionSource: 'DirectQuery to AS - {{WORKSPACE_ID}}/{{SEMANTIC_MODEL_ID}}'

		annotation ONT_WorkspaceId = {{WORKSPACE_ID}}
		annotation ONT_ItemId = {{SEMANTIC_MODEL_ID}}
		annotation ONT_ItemKind = Dataset
		annotation ONT_ItemName = {{SEMANTIC_MODEL_NAME}}
		annotation ONT_WorkspaceName = {{WORKSPACE_NAME}}
		annotation ONT_PinnedAtUtc = {{PINNED_AT_UTC}}
