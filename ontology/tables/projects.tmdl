table projects
	lineageTag: 7e8dc04b-6d05-5b23-b8d2-01640ad456b2

	/// Budget in euros that the customer approved for the project.
	measure 'Budget EUR' = EXTERNALMEASURE("Budget EUR", DOUBLE, "DirectQuery to AS - {{WORKSPACE_ID}}/{{SEMANTIC_MODEL_ID}}")
		formatString: #,##0
		lineageTag: 7f26bbbe-24ad-5267-8aca-6cf21b26cd43

	/// Planned cost minus budget, in euros. A positive value means the plan is over budget.
	measure 'Budget Variance EUR' = EXTERNALMEASURE("Budget Variance EUR", DOUBLE, "DirectQuery to AS - {{WORKSPACE_ID}}/{{SEMANTIC_MODEL_ID}}")
		formatString: #,##0
		lineageTag: 6752e08d-2042-5333-82b6-f3c6779cee8d

	column ProjectId
		dataType: string
		lineageTag: cdb43ee7-cff1-5757-8575-f5ac98c2fdf8
		sourceColumn: ProjectId

	column Name
		dataType: string
		lineageTag: 6a079c32-b3a4-5d6e-8f17-6cac67b3e8c2
		sourceColumn: Name

	column Customer
		dataType: string
		lineageTag: 6895643e-a762-560a-8af1-120e229f1333
		sourceColumn: Customer

	column ManagerId
		dataType: string
		lineageTag: bba07907-b8c5-5242-bc12-f00f24c60a7d
		sourceColumn: ManagerId

	column StartDate
		dataType: dateTime
		formatString: General Date
		lineageTag: c6640172-fade-586e-9dfd-7baaaf0f4fe6
		sourceColumn: StartDate

	column EndDate
		dataType: dateTime
		formatString: General Date
		lineageTag: b42aa3df-12f8-595e-bcf5-70c347257ebe
		sourceColumn: EndDate

	column BudgetEur
		dataType: double
		lineageTag: 18e67345-ccb7-524b-9af6-d30c1e530c62
		sourceColumn: BudgetEur

	partition projects-partition = entity
		mode: directQuery
		source
			entityName: projects
			expressionSource: 'DirectQuery to AS - {{WORKSPACE_ID}}/{{SEMANTIC_MODEL_ID}}'

		annotation ONT_WorkspaceId = {{WORKSPACE_ID}}
		annotation ONT_ItemId = {{SEMANTIC_MODEL_ID}}
		annotation ONT_ItemKind = Dataset
		annotation ONT_ItemName = {{SEMANTIC_MODEL_NAME}}
		annotation ONT_WorkspaceName = {{WORKSPACE_NAME}}
		annotation ONT_PinnedAtUtc = {{PINNED_AT_UTC}}
