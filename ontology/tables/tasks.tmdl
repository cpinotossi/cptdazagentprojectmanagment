table tasks
	lineageTag: 22fb2a43-b232-581d-b2f5-16be87e41e7a

	/// Duration in calendar days from the first StartDate to the last EndDate, both days counted. For one task this is the duration of that task.
	measure 'Duration Days' = EXTERNALMEASURE("Duration Days", INTEGER, "SemanticModelSource")
		formatString: 0
		lineageTag: a4683fc6-394b-54f0-a26f-f66ff9c2de74

	/// Planned cost in euros: the sum of the cost of the tasks. Not the same as the budget of the project.
