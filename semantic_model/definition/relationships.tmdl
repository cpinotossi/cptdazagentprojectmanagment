relationship rel_project_managed_by
	fromColumn: projects.ManagerId
	toColumn: project_managers.ManagerId

relationship rel_document_of_project
	fromColumn: documents.ProjectId
	toColumn: projects.ProjectId

relationship rel_email_about_project
	fromColumn: emails.ProjectId
	toColumn: projects.ProjectId

relationship rel_task_of_project
	fromColumn: tasks.ProjectId
	toColumn: projects.ProjectId

relationship rel_dependency_task
	fromColumn: task_dependencies.TaskId
	toColumn: tasks.TaskId

relationship rel_dependency_predecessor
	isActive: false
	fromColumn: task_dependencies.PredecessorId
	toColumn: tasks.TaskId

relationship rel_delivery_from_supplier
	fromColumn: material_deliveries.SupplierId
	toColumn: suppliers.SupplierId

relationship rel_delivery_of_material
	fromColumn: material_deliveries.MaterialId
	toColumn: materials.MaterialId

relationship rel_delivery_for_task
	fromColumn: material_deliveries.TaskId
	toColumn: tasks.TaskId

relationship rel_portfolio_supplier
	fromColumn: supplier_materials.SupplierId
	toColumn: suppliers.SupplierId

relationship rel_portfolio_material
	fromColumn: supplier_materials.MaterialId
	toColumn: materials.MaterialId
